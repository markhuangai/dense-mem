    "test:phase1": "playwright test phase1-indexes.spec.ts",
    "test:phase2": "playwright test phase2-claim-create.spec.ts phase2-claim-dedupe.spec.ts",
    "test:phase3": "playwright test phase3-verify.spec.ts phase3-verify-errors.spec.ts",
    "test:phase4": "playwright test phase4-promote.spec.ts phase4-contradiction.spec.ts phase4-promote-concurrency.spec.ts",
    "test:phase6": "playwright test phase6-retract.spec.ts",
    "test:phase7": "playwright test phase7-community.spec.ts",
    "test:phase8": "playwright test phase8-mcp.spec.ts",
    "test:phase9": "playwright test phase9-recall.spec.ts",
    "test:permissions": "playwright test profile-key-permissions.spec.ts",
    "test:control-plane": "playwright test control-plane-lifecycle.spec.ts auth-matrix.spec.ts",
    "test:cli": "playwright test cli-workflows.spec.ts",
    "test:portal-live": "playwright test control-portal-live.spec.ts",
    "test:admin": "playwright test control-plane-lifecycle.spec.ts auth-matrix.spec.ts cli-workflows.spec.ts control-portal-live.spec.ts",
