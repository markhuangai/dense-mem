+package evalharness
+
+import (
+	"context"
+	"errors"
+	"net/http"
+	"path/filepath"
+	"strconv"
+	"time"
+
+	ontology "github.com/markhuangai/dense-mem/internal/ontology/contract"
+)
+
+type receiptTrialPoint struct {
+	ElapsedMS int64
+	Observed  time.Time
+	Counts    ontology.MaintenanceCounts
+	Active    int
+}
+
+type receiptTrialResult struct {
+	RunID, Source, Image, Parent, Canonical string
+	Started, MeasuredEnd, Paused            time.Time
+	Progress                                []receiptTrialPoint
+	NetOrganized                            int64
+	Usage                                   AttemptMeasurement
+	Drained                                 bool
+}
+
+func observeReceiptTrial(ctx context.Context, manifest Manifest, client *HTTPClient, native *Native, initial NativeObservation, canonical string) error {
+	const measured = time.Hour
+	if manifest.SeedBuildID == "" || manifest.Dataset != "hotpotqa" || manifest.ResumeScope == nil ||
+		initial.CanonicalHash != canonical || initial.Ontology.Counts.Eligible != 13810 ||
+		initial.Ontology.Counts.Organized != 3295 || initial.Ontology.Counts.Pending != 10446 ||
+		initial.Ontology.Counts.Ambiguous != 61 || initial.Ontology.Counts.Failed != 8 ||
+		len(initial.ProviderAttempts) != 2506 || initial.ForeignWork != 0 || initial.ForeignSources != 0 {
+		return errors.New("HotpotQA trial did not start from the archived paused checkpoint")
+	}
+	if time.Until(manifest.ModelDeadline) < measured+time.Minute {
+		return errors.New("HotpotQA trial cannot finish its measured hour within the reserved budget")
+	}
+	result := receiptTrialResult{
+		RunID: manifest.RunID, Source: manifest.SourceRevision, Image: manifest.Image,
+		Parent: manifest.SeedImage, Canonical: canonical,
+	}
+	path := filepath.Join(manifest.BakeStateDir, "receipt-trial-result.json")
+	if err := native.EnableOntology(ctx, manifest); err != nil {
+		return err
+	}
+	prior := make(map[string]bool, len(initial.ProviderAttempts))
+	for _, attempt := range initial.ProviderAttempts {
+		prior[receiptTrialAttemptKey(attempt)] = true
+	}
+	for {
+		var status ontology.MaintenanceStatus
+		if err := native.Control(ctx, http.MethodGet, "/ontology/status", nil, &status); err != nil {
+			return err
+		}
+		if !status.Enabled || status.Paused || status.ConfigurationError != "" {
+			return errors.New("HotpotQA observation lost its native ontology settings")
+		}
+		if status.Window != nil {
+			if err := nativeOntologyPolicy(status, manifest, native.Scope.TeamID); err != nil {
+				return err
+			}
+		}
+		now := time.Now().UTC()
+		if result.Started.IsZero() {
+			result.Started = now
+		}
+		point := receiptTrialPoint{ElapsedMS: now.Sub(result.Started).Milliseconds(), Observed: now,
+			Counts: status.Counts, Active: status.ActiveWork}
+		if len(result.Progress) == 0 || now.Sub(result.Progress[len(result.Progress)-1].Observed) >= 5*time.Minute || now.Sub(result.Started) >= measured {
+			result.Progress = append(result.Progress, point)
+			if err := writeJSON(path, result); err != nil {
+				return err
+			}
+			if client.Capture != nil && client.Capture.Logger != nil {
+				client.Capture.Logger.InfoContext(ctx, "ontology receipt trial progress", "run_id", manifest.RunID,
+					"elapsed_ms", point.ElapsedMS, "organized", point.Counts.Organized, "eligible", point.Counts.Eligible,
+					"pending", point.Counts.Pending, "active", point.Active)
+			}
+		}
+		if now.Sub(result.Started) >= measured {
+			result.MeasuredEnd = now
+			result.NetOrganized = int64(point.Counts.Organized - result.Progress[0].Counts.Organized)
+			break
+		}
+		select {
+		case <-ctx.Done():
+			return ctx.Err()
+		case <-time.After(min(10*time.Second, time.Until(result.Started.Add(measured)))):
+		}
+	}
+	if err := writeJSON(path, result); err != nil {
+		return err
+	}
+	drain, finish := context.WithTimeout(context.WithoutCancel(ctx), 16*time.Minute)
+	defer finish()
+	if err := pausePreparation(drain, native); err != nil {
+		return err
+	}
+	final, err := native.Snapshot(drain)
+	if err != nil {
+		return err
+	}
+	if final.CanonicalHash != canonical || final.ForeignSources != 0 || final.ForeignWork != 0 ||
+		!final.Ontology.Paused || nativeDrained(final) != nil {
+		return errors.New("HotpotQA trial failed its paused, drained and canonical verification")
+	}
+	var measuredAttempts []NativeAttempt
+	for _, attempt := range final.ProviderAttempts {
+		if !prior[receiptTrialAttemptKey(attempt)] && !attempt.AdmittedAt.Before(result.Started) && !attempt.AdmittedAt.After(result.MeasuredEnd) {
+			measuredAttempts = append(measuredAttempts, attempt)
+		}
+	}
+	result.Usage, err = MeasureAttempts(measuredAttempts)
+	if err != nil {
+		return err
+	}
+	result.Paused = time.Now().UTC()
+	result.Drained = true
+	if err := writeJSON(path, result); err != nil {
+		return err
+	}
+	if native.RuntimeLogs != nil {
+		return native.RuntimeLogs(drain)
+	}
+	return nil
+}
+
+func receiptTrialAttemptKey(attempt NativeAttempt) string {
+	return attempt.OperationKey + "/" + attempt.AssessmentID + "/" + strconv.Itoa(attempt.Number)
+}
