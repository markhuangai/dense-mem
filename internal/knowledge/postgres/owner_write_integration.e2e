const (
	ownerTestRole     = "densemem_owner_e2e"
	ownerTestPassword = "densemem_owner_e2e"
)

var ownerContractVersion atomic.Int64

func TestKnowledgeOwnerTerminalReplay(t *testing.T) {
	adminDB, appDB, rls, cleanup := setupKnowledgeOwnerDB(t)
	defer cleanup()

	teamID := createOwnerTeam(t, adminDB, rls, "knowledge-owner-replay")
	ownerID := createOwnerProfile(t, adminDB, rls, teamID, "knowledge-owner-replay-owner")
	installOwnerSearchContract(t, adminDB, rls, "owner-replay", 3, 1)
	store := knowledgepostgres.NewStore(appDB, rls, knowledgepostgres.ConflictRuntimeConfig{})
	input := ownerRememberInput(teamID, ownerID, "owner-replay")

	plan, err := store.PlanRememberEmbeddings(context.Background(), input)
	require.NoError(t, err)
	first, err := store.CommitRememberWithEmbeddings(context.Background(), input, ownerEmbeddings(plan, false))
	require.NoError(t, err)
	require.Equal(t, "completed", first.Outcome)

	second, err := store.CommitRememberWithEmbeddings(context.Background(), input, ownerEmbeddings(plan, false))
	require.ErrorIs(t, err, knowledgepostgres.ErrRememberReplay)
	firstJSON, marshalErr := json.Marshal(first.PublicResult)
	require.NoError(t, marshalErr)
	secondJSON, marshalErr := json.Marshal(second.PublicResult)
	require.NoError(t, marshalErr)
	require.JSONEq(t, string(firstJSON), string(secondJSON))
	require.EqualValues(t, 1, ownerCount(t, adminDB, rls, "remember_attempts", teamID, input.IngestID))
}

func TestKnowledgeOwnerLateFailureRollsBack(t *testing.T) {
	adminDB, appDB, rls, cleanup := setupKnowledgeOwnerDB(t)
	defer cleanup()

	teamID := createOwnerTeam(t, adminDB, rls, "knowledge-owner-rollback")
	ownerID := createOwnerProfile(t, adminDB, rls, teamID, "knowledge-owner-rollback-owner")
	installOwnerSearchContract(t, adminDB, rls, "owner-rollback", 3, 1)
	store := knowledgepostgres.NewStore(appDB, rls, knowledgepostgres.ConflictRuntimeConfig{})
	input := ownerRememberInput(teamID, ownerID, "owner-rollback")

	plan, err := store.PlanRememberEmbeddings(context.Background(), input)
	require.NoError(t, err)
	_, err = store.CommitRememberWithEmbeddings(context.Background(), input, ownerEmbeddings(plan, true))
	require.Error(t, err)
	require.Zero(t, ownerCount(t, adminDB, rls, "knowledge_ingests", teamID, input.IngestID))
	require.Zero(t, ownerCount(t, adminDB, rls, "evidence_fragments", teamID, input.IngestID))
	require.Zero(t, ownerCount(t, adminDB, rls, "search_documents", teamID, input.IngestID))
	require.Zero(t, ownerCount(t, adminDB, rls, "remember_attempts", teamID, input.IngestID))
}

func TestKnowledgeOwnerConcurrentRetryUsesOneCommit(t *testing.T) {
	adminDB, appDB, rls, cleanup := setupKnowledgeOwnerDB(t)
	defer cleanup()

	teamID := createOwnerTeam(t, adminDB, rls, "knowledge-owner-concurrent")
	ownerID := createOwnerProfile(t, adminDB, rls, teamID, "knowledge-owner-concurrent-owner")
	installOwnerSearchContract(t, adminDB, rls, "owner-concurrent", 3, 1)
	store := knowledgepostgres.NewStore(appDB, rls, knowledgepostgres.ConflictRuntimeConfig{})
	input := ownerRememberInput(teamID, ownerID, "owner-concurrent")
	plan, err := store.PlanRememberEmbeddings(context.Background(), input)
	require.NoError(t, err)
	embeddings := ownerEmbeddings(plan, false)

	results := make(chan error, 2)
	var wait sync.WaitGroup
	wait.Add(2)
	for range 2 {
		go func() {
			defer wait.Done()
			_, commitErr := store.CommitRememberWithEmbeddings(context.Background(), input, embeddings)
			results <- commitErr
		}()
	}
	wait.Wait()
	close(results)

	var success, replay int
	for commitErr := range results {
		if commitErr == nil {
			success++
			continue
		}
		require.ErrorIs(t, commitErr, knowledgepostgres.ErrRememberReplay)
		replay++
	}
	require.Equal(t, 1, success)
	require.Equal(t, 1, replay)
	require.EqualValues(t, 1, ownerCount(t, adminDB, rls, "knowledge_ingests", teamID, input.IngestID))
	require.EqualValues(t, 1, ownerCount(t, adminDB, rls, "remember_attempts", teamID, input.IngestID))
}

func TestKnowledgeOwnerRejectsStaleEmbeddingFence(t *testing.T) {
	adminDB, appDB, rls, cleanup := setupKnowledgeOwnerDB(t)
	defer cleanup()

	teamID := createOwnerTeam(t, adminDB, rls, "knowledge-owner-fence")
	ownerID := createOwnerProfile(t, adminDB, rls, teamID, "knowledge-owner-fence-owner")
	oldVersion := int(ownerContractVersion.Add(1))
	installOwnerSearchContract(t, adminDB, rls, "owner-fence-old", 3, oldVersion)
	store := knowledgepostgres.NewStore(appDB, rls, knowledgepostgres.ConflictRuntimeConfig{})
	input := ownerRememberInput(teamID, ownerID, "owner-fence")
	plan, err := store.PlanRememberEmbeddings(context.Background(), input)
	require.NoError(t, err)

	installOwnerSearchContract(t, adminDB, rls, "owner-fence-new", 3, oldVersion+1)
	_, err = store.CommitRememberWithEmbeddings(context.Background(), input, ownerEmbeddings(plan, false))
	require.ErrorIs(t, err, knowledgepostgres.ErrSearchContractMismatch)
	require.Zero(t, ownerCount(t, adminDB, rls, "knowledge_ingests", teamID, input.IngestID))
	require.Zero(t, ownerCount(t, adminDB, rls, "remember_attempts", teamID, input.IngestID))
}

func TestKnowledgeOwnerTeamProfileIsolation(t *testing.T) {
	adminDB, appDB, rls, cleanup := setupKnowledgeOwnerDB(t)
	defer cleanup()

	teamA := createOwnerTeam(t, adminDB, rls, "knowledge-owner-isolation-a")
	ownerA := createOwnerProfile(t, adminDB, rls, teamA, "knowledge-owner-isolation-a")
	ownerB := createOwnerProfile(t, adminDB, rls, teamA, "knowledge-owner-isolation-b")
	teamC := createOwnerTeam(t, adminDB, rls, "knowledge-owner-isolation-c")
	ownerC := createOwnerProfile(t, adminDB, rls, teamC, "knowledge-owner-isolation-c")
	installOwnerSearchContract(t, adminDB, rls, "owner-isolation", 3, 1)
	store := knowledgepostgres.NewStore(appDB, rls, knowledgepostgres.ConflictRuntimeConfig{})
	input := ownerRememberInput(teamA, ownerA, "owner-isolation")
	plan, err := store.PlanRememberEmbeddings(context.Background(), input)
	require.NoError(t, err)
	_, err = store.CommitRememberWithEmbeddings(context.Background(), input, ownerEmbeddings(plan, false))
	require.NoError(t, err)

	_, err = store.RetractEvidence(context.Background(), knowledgepostgres.RetractEvidenceInput{
		TeamID: teamA, OwnerProfileID: ownerB, EvidenceIDs: []string{input.Evidence[0].FragmentID},
		Reason: "non-owner", IdempotencyKey: "owner-isolation-b", RequestHash: "owner-isolation-b",
	})
	require.ErrorIs(t, err, knowledgepostgres.ErrEvidenceLifecycleNotFound)
	_, err = store.RetractEvidence(context.Background(), knowledgepostgres.RetractEvidenceInput{
		TeamID: teamA, OwnerProfileID: ownerC, EvidenceIDs: []string{input.Evidence[0].FragmentID},
		Reason: "cross-team", IdempotencyKey: "owner-isolation-c", RequestHash: "owner-isolation-c",
	})
	require.ErrorIs(t, err, knowledgepostgres.ErrEvidenceLifecycleNotFound)
	require.Zero(t, ownerCount(t, adminDB, rls, "evidence_lifecycle_events", teamA, input.IngestID))
	require.EqualValues(t, 1, ownerCount(t, adminDB, rls, "evidence_fragments", teamA, input.IngestID))
}

func setupKnowledgeOwnerDB(t *testing.T) (*gorm.DB, *gorm.DB, *postgres.RLS, func()) {
	t.Helper()
	ctx := context.Background()
	dsn := postgres.GetTestDSN()
	var baseCleanup func()
	if dsn == "" {
		if os.Getenv("DENSE_MEM_REPOSITORY_TESTCONTAINERS") != "1" {
			if os.Getenv("DENSE_MEM_REQUIRE_POSTGRES_TESTS") == "1" {
				t.Fatal("Postgres is required for knowledge owner E2E tests")
			}
			t.Skip("set DENSE_MEM_REPOSITORY_TESTCONTAINERS=1 to run knowledge owner PostgreSQL tests")
		}
		options := []testcontainers.ContainerCustomizer{
			tcpostgres.WithDatabase("testdb"),
			tcpostgres.WithUsername("testuser"),
			tcpostgres.WithPassword("testpass"),
			testcontainers.WithWaitStrategy(wait.ForLog("database system is ready to accept connections").WithOccurrence(2).WithStartupTimeout(30 * time.Second)),
		}
		if networkName := strings.TrimSpace(os.Getenv("DENSE_MEM_CI_PRECHECK_NETWORK")); networkName != "" {
			options = append(options, tcnetwork.WithNetworkName([]string{"postgres"}, networkName))
		}
		container, err := tcpostgres.Run(ctx, "pgvector/pgvector:0.8.2-pg18-trixie", options...)
		require.NoError(t, err)
		baseCleanup = func() { _ = container.Terminate(ctx) }
		if strings.TrimSpace(os.Getenv("DENSE_MEM_CI_PRECHECK_NETWORK")) == "" {
			dsn, err = container.ConnectionString(ctx, "sslmode=disable")
			require.NoError(t, err)
		} else {
			dsn = "postgres://testuser:testpass@postgres:5432/testdb?sslmode=disable"
		}
	} else {
		if os.Getenv("DENSE_MEM_ALLOW_DESTRUCTIVE_POSTGRES_TESTS") != "1" {
			t.Skip("set DENSE_MEM_ALLOW_DESTRUCTIVE_POSTGRES_TESTS=1 to run destructive knowledge owner tests against DATABASE_URL")
		}
		baseCleanup = func() {}
	}

	adminDB, err := gorm.Open(gormpostgres.Open(dsn), &gorm.Config{})
	require.NoError(t, err)
	migrator, err := postgres.NewMigrator(adminDB)
	require.NoError(t, err)
	require.NoError(t, migrator.RunUp(ctx))
	rls := postgres.NewRLS()
	require.NoError(t, rls.WithSystemTx(ctx, adminDB, func(tx *gorm.DB) error {
		return tx.Exec(fmt.Sprintf(`
			DO $$
			BEGIN
				IF NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = '%[1]s') THEN
					CREATE ROLE %[1]s LOGIN PASSWORD '%[2]s' NOSUPERUSER NOBYPASSRLS;
				ELSE
					ALTER ROLE %[1]s WITH LOGIN PASSWORD '%[2]s' NOSUPERUSER NOBYPASSRLS;
				END IF;
			END $$;
			GRANT USAGE ON SCHEMA public TO %[1]s;
			GRANT SELECT, INSERT, UPDATE, DELETE ON ALL TABLES IN SCHEMA public TO %[1]s;
			GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO %[1]s;
			GRANT EXECUTE ON ALL FUNCTIONS IN SCHEMA public TO %[1]s;
		`, ownerTestRole, ownerTestPassword)).Error
	}))
	appURL, err := url.Parse(dsn)
	require.NoError(t, err)
	appURL.User = url.UserPassword(ownerTestRole, ownerTestPassword)
	appDB, err := gorm.Open(gormpostgres.Open(appURL.String()), &gorm.Config{})
	require.NoError(t, err)
	require.NoError(t, rls.WithSystemTx(ctx, adminDB, func(tx *gorm.DB) error {
		if err := tx.Exec(`TRUNCATE TABLE search_index_generations, embedding_contracts CASCADE`).Error; err != nil {
			return err
		}
		return tx.Exec(`TRUNCATE TABLE teams CASCADE`).Error
	}))
	cleanup := func() {
		_ = rls.WithSystemTx(ctx, adminDB, func(tx *gorm.DB) error {
			if err := tx.Exec(`TRUNCATE TABLE search_index_generations, embedding_contracts CASCADE`).Error; err != nil {
				return err
			}
			return tx.Exec(`TRUNCATE TABLE teams CASCADE`).Error
		})
		if sqlDB, closeErr := appDB.DB(); closeErr == nil {
			_ = sqlDB.Close()
		}
		_ = rls.WithSystemTx(ctx, adminDB, func(tx *gorm.DB) error {
			return tx.Exec(fmt.Sprintf(`REASSIGN OWNED BY %[1]s TO CURRENT_USER; DROP OWNED BY %[1]s; DROP ROLE IF EXISTS %[1]s`, ownerTestRole)).Error
		})
		if sqlDB, closeErr := adminDB.DB(); closeErr == nil {
			_ = sqlDB.Close()
		}
		baseCleanup()
	}
	return adminDB, appDB, rls, cleanup
}

func createOwnerTeam(t *testing.T, db *gorm.DB, rls *postgres.RLS, name string) string {
	t.Helper()
	id := uuid.NewString()
	require.NoError(t, rls.WithSystemTx(context.Background(), db, func(tx *gorm.DB) error {
		return tx.Exec(`INSERT INTO teams (id, name, description, metadata, config) VALUES (?::uuid, ?, '', '{}'::jsonb, '{}'::jsonb)`, id, name).Error
	}))
	return id
}

func createOwnerProfile(t *testing.T, db *gorm.DB, rls *postgres.RLS, teamID, name string) string {
	t.Helper()
	id := uuid.New()
	credential := &domain.Credential{
		ID: id, TeamID: uuid.MustParse(teamID), Name: name,
		KeyHash: "owner-e2e-hash-" + id.String(), KeyPrefix: strings.ReplaceAll(id.String(), "-", "")[:24],
		Scopes: []string{"read", "write"}, Role: "member",
	}
	require.NoError(t, repository.NewCredentialRepository(db, rls).CreateCredential(context.Background(), credential))
	return id.String()
}

func installOwnerSearchContract(t *testing.T, db *gorm.DB, rls *postgres.RLS, key string, dimensions, version int) {
	t.Helper()
	contractID, generationID := uuid.NewString(), uuid.NewString()
	if version == 1 {
		version = int(ownerContractVersion.Add(1))
		if version < 1 {
			version = 1
		}
	}
	require.NoError(t, rls.WithSystemTx(context.Background(), db, func(tx *gorm.DB) error {
		if err := tx.Exec(`
			INSERT INTO embedding_contracts (
			    embedding_contract_id, contract_key, version, provider, model,
			    dimensions, distance_metric, vector_normalization,
			    document_format_version, query_format_version, lifecycle_state
			) VALUES (?::uuid, ?, ?, 'test', 'owner-e2e-model', ?, 'cosine', 'provider', 1, 1, 'active')
		`, contractID, key, version, dimensions).Error; err != nil {
			return err
		}
		return tx.Exec(`
			INSERT INTO search_index_generations (
			    search_index_generation_id, generation, embedding_contract_id,
			    embedding_dimensions, ann_strategy, operator_class,
			    indexed_expression, physical_index_name, exact_max_rows,
			    allow_exact_fallback, activation_state, activated_at
			) VALUES (?::uuid, ?, ?::uuid, ?, 'exact', '', '', '', 10000, false, 'active', now())
		`, generationID, version, contractID, dimensions).Error
	}))
}

func ownerRememberInput(teamID, ownerID, label string) knowledgepostgres.SynchronousRememberCommitInput {
	fragmentID, ingestID, assessmentID := uuid.NewString(), uuid.NewString(), uuid.NewString()
	content := "Knowledge owner evidence [" + label + "]"
	return knowledgepostgres.SynchronousRememberCommitInput{
		TeamID: teamID, OwnerProfileID: ownerID, IngestID: ingestID,
		IdempotencyKey: label, RequestHash: "request-" + label, SourceSummary: label,
		Evidence:     []knowledgepostgres.EvidenceInput{{FragmentID: fragmentID, Content: content, ContentHash: "sha256:" + fmt.Sprintf("%x", sha256.Sum256([]byte(content))), SourceType: "manual", Authority: "primary"}},
		AssessmentID: assessmentID, AssessmentJSON: []byte(`{"request_id":"` + label + `"}`), ProviderTurns: 1,
		EvidenceSecurityResults: []knowledgepostgres.EvidenceSecurityResult{{FragmentID: fragmentID, EvidenceID: "evidence:0", EvidenceIndex: 0, Decision: "pass", Safe: true}},
		Commit: knowledgepostgres.CommitSubmissionAssessmentInput{
			AssessmentID: assessmentID, Items: []knowledgepostgres.SubmissionAssessmentItemInput{{FragmentID: fragmentID}},
			Payload: map[string]any{
				"response_hash": "sha256:" + fmt.Sprintf("%x", sha256.Sum256([]byte(label))), "model": "owner-e2e-model", "tokenizer": "o200k_base",
				"candidate_context_tokens": 0, "candidate_context_truncated": false,
			},
		},
	}
}

func ownerEmbeddings(plan *knowledgepostgres.InlineEmbeddingPlan, invalid bool) []knowledgepostgres.InlineEmbeddingResult {
	vector := make([]float32, plan.EmbeddingDimensions)
	if invalid {
		vector = vector[:1]
	} else if len(vector) > 0 {
		vector[0] = 1
	}
	results := make([]knowledgepostgres.InlineEmbeddingResult, 0, len(plan.Documents))
	for _, document := range plan.Documents {
		results = append(results, knowledgepostgres.InlineEmbeddingResult{
			DocumentHash: document.DocumentHash, Embedding: append([]float32(nil), vector...),
			EmbeddingContractID: plan.EmbeddingContractID, EmbeddingDimensions: plan.EmbeddingDimensions,
			EmbeddingModel: plan.EmbeddingModel, SearchIndexGenerationID: plan.SearchIndexGenerationID,
			IndexGeneration: plan.IndexGeneration,
		})
	}
	return results
}

func ownerCount(t *testing.T, db *gorm.DB, rls *postgres.RLS, table, teamID, ingestID string) int64 {
	t.Helper()
	var count int64
	var query string
	switch table {
	case "knowledge_ingests":
		query = `SELECT count(*) FROM knowledge_ingests WHERE team_id = ?::uuid AND ingest_id = ?::uuid`
	case "evidence_fragments":
		query = `SELECT count(*) FROM evidence_fragments WHERE team_id = ?::uuid AND ingest_id = ?::uuid`
	case "search_documents":
		query = `SELECT count(*) FROM search_documents WHERE team_id = ?::uuid AND source_kind = 'evidence' AND source_id IN (SELECT fragment_id FROM evidence_fragments WHERE team_id = ?::uuid AND ingest_id = ?::uuid)`
	case "remember_attempts":
		query = `SELECT count(*) FROM remember_attempts WHERE team_id = ?::uuid AND attempt_id = ?::uuid`
	case "evidence_lifecycle_events":
		query = `SELECT count(*) FROM evidence_lifecycle_events WHERE team_id = ?::uuid AND target_fragment_id IN (SELECT fragment_id FROM evidence_fragments WHERE team_id = ?::uuid AND ingest_id = ?::uuid)`
	default:
		t.Fatalf("unsupported owner count table %q", table)
	}
	require.NoError(t, rls.WithSystemTx(context.Background(), db, func(tx *gorm.DB) error {
		if table == "search_documents" || table == "evidence_lifecycle_events" {
			return tx.Raw(query, teamID, teamID, ingestID).Row().Scan(&count)
		}
		return tx.Raw(query, teamID, ingestID).Row().Scan(&count)
	}))
	return count
}
