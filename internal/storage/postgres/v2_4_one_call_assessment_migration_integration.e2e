				1, 1, $5::uuid, 3,
				'pending', 'V2.4 must preserve this search document.', 'sha256:v24-search-document', '{"fixture":"v24"}'::jsonb
			)
		`, teamID, documentID, profileID, sourceID, contractID); err != nil {
