				'relationship', $5::uuid, 1, 1,
				$6::uuid, 3, 'queued', 0, 5
			)
		`, teamID, jobID, documentID, profileID, sourceID, contractID)
		return err
	}))
}

type v24OneCallAssessmentSemanticSearchSnapshot struct {
	relationships string
	observations  string
	verifications string
	supports      string
	documents     string
	embeddingJobs string
}

func loadV24OneCallAssessmentSemanticSearchSnapshot(
	t *testing.T,
	ctx context.Context,
	db *sql.DB,
	teamID string,
) v24OneCallAssessmentSemanticSearchSnapshot {
	t.Helper()
	var snapshot v24OneCallAssessmentSemanticSearchSnapshot
	require.NoError(t, execPostgresTxMode(ctx, db, "migration", func(tx *sql.Tx) error {
		if err := tx.QueryRowContext(ctx, `
			SELECT COALESCE(md5(string_agg(
				relationship_id::text || '|' || semantic_group_key || '|' || status || '|'
				|| support_count::text || '|' || source_group_count::text || '|' || version::text || '|'
				|| COALESCE(identity_alias_of_relationship_id::text, '') || '|'
				|| COALESCE(recorded_to::text, ''),
				'~' ORDER BY relationship_id)), '')
			FROM relationship_records WHERE team_id = $1::uuid
		`, teamID).Scan(&snapshot.relationships); err != nil {
			return err
		}
		if err := tx.QueryRowContext(ctx, `
			SELECT COALESCE(md5(string_agg(
				observation_id::text || '|' || COALESCE(relationship_id::text, '') || '|' || subject_ref || '|'
				|| original_predicate || '|' || object_ref || '|' || COALESCE(predicate_key, '') || '|'
				|| COALESCE(predicate_version::text, ''),
				'~' ORDER BY observation_id)), '')
			FROM relationship_observations WHERE team_id = $1::uuid
		`, teamID).Scan(&snapshot.observations); err != nil {
			return err
		}
		if err := tx.QueryRowContext(ctx, `
			SELECT COALESCE(md5(string_agg(
				verification_event_id::text || '|' || observation_id::text || '|' || evidence_verdict || '|'
				|| COALESCE(confidence::text, '') || '|' || rationale || '|' || model || '|' || response_hash,
				'~' ORDER BY verification_event_id)), '')
			FROM verification_events WHERE team_id = $1::uuid
		`, teamID).Scan(&snapshot.verifications); err != nil {
			return err
		}
		if err := tx.QueryRowContext(ctx, `
			SELECT COALESCE(md5(string_agg(
				support_id::text || '|' || relationship_id::text || '|' || observation_id::text || '|'
				|| verification_event_id::text || '|' || fragment_id::text || '|' || source_group_key || '|'
				|| span_start::text || '|' || span_end::text || '|' || authority,
				'~' ORDER BY support_id)), '')
			FROM relationship_evidence_supports WHERE team_id = $1::uuid
		`, teamID).Scan(&snapshot.supports); err != nil {
			return err
		}
		if err := tx.QueryRowContext(ctx, `
			SELECT COALESCE(md5(string_agg(
				search_document_id::text || '|' || source_kind || '|' || source_id::text || '|'
				|| source_version::text || '|' || document_version::text || '|' || embedding_contract_id::text || '|'
				|| search_state || '|' || document_text || '|' || document_hash || '|' || metadata::text,
				'~' ORDER BY search_document_id)), '')
			FROM search_documents WHERE team_id = $1::uuid
		`, teamID).Scan(&snapshot.documents); err != nil {
			return err
		}
		return tx.QueryRowContext(ctx, `
			SELECT COALESCE(md5(string_agg(
				embedding_job_id::text || '|' || search_document_id::text || '|' || source_kind || '|'
				|| source_id::text || '|' || source_version::text || '|' || document_version::text || '|'
				|| embedding_contract_id::text || '|' || status || '|' || attempts::text || '|'
				|| max_attempts::text || '|' || error,
				'~' ORDER BY embedding_job_id)), '')
			FROM embedding_jobs WHERE team_id = $1::uuid
		`, teamID).Scan(&snapshot.embeddingJobs)
	}))
	return snapshot
}
