# Dense Memory API Server Configuration

# =============================================================================
# Quick Start — Required Values
# =============================================================================

# The base compose example refuses to start until these three values are set.
# Find each one in its section below; everything else has a working local
# default.
#
#   POSTGRES_PASSWORD      Database Configuration (PostgreSQL)
#   CONTROL_PORTAL_TOKEN   Local Control Portal Configuration
#   AI_API_KEY             Embedding Configuration

# =============================================================================
# Logging Configuration
# =============================================================================

# Logging level. Set to debug for verbose logs.
LOG_LEVEL=info

# =============================================================================
# Local Control Portal Configuration
# =============================================================================

# Required for the local profile/API-key management portal.
# Send as Bearer or X-Control-Portal-Token.
CONTROL_PORTAL_TOKEN=

# Control portal bind address. The compose examples publish this on
# 127.0.0.1 only; do not expose it publicly.
CONTROL_HTTP_ADDR=:8090

# Main MCP/API listener inside the container.
HTTP_ADDR=:8080

# Host port used by the base compose example for the MCP/API listener.
DENSE_MEM_PORT=8080

# Host bind for the expert compose example. Keep this on loopback or an
# internal/LAN address; do not bind it to 0.0.0.0 on an internet-facing host.
CONTROL_PORTAL_BIND=127.0.0.1
CONTROL_PORTAL_PORT=8090

# Request/body/runtime hardening.
HTTP_MAX_BODY_BYTES=1048576
AUTH_VERIFY_MAX_CONCURRENCY=8

# =============================================================================
# Telemetry Configuration (optional)
# =============================================================================

# Enable Prometheus metrics collection and telemetry query APIs.
TELEMETRY_ENABLED=false

# Prometheus base URL used by /ui/api/telemetry and /control/api/telemetry.
# The telemetry compose overlay supplies http://prometheus:9090.
TELEMETRY_PROMETHEUS_URL=

# Optional Prometheus scrape job filter for shared Prometheus instances.
# The base telemetry overlay defaults this to dense-mem; the demo telemetry
# overlay defaults it to dense-mem-demo.
TELEMETRY_PROMETHEUS_JOB=

# Timeout for Prometheus query requests.
TELEMETRY_QUERY_TIMEOUT_SECONDS=5

# Bearer token required by /metrics when TELEMETRY_ENABLED=true. Leave empty
# while telemetry is disabled; set a high-entropy value before using the
# telemetry compose overlay.
TELEMETRY_SCRAPE_TOKEN=

# Host port for the telemetry compose overlay's Prometheus UI/API.
PROMETHEUS_PORT=9090

# Optional fixed container name for the base compose Prometheus service.
PROMETHEUS_CONTAINER_NAME=prometheus

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================

# Docker compose database credentials. The server image builds POSTGRES_DSN
# from these values at container startup when POSTGRES_DSN is not set.
POSTGRES_USER=densemem
POSTGRES_PASSWORD=
POSTGRES_DB=densemem
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_SSLMODE=disable

# Host port used by the base compose example for PostgreSQL.
POSTGRES_HOST_PORT=5432

# PostgreSQL connection pool limits.
POSTGRES_MAX_OPEN_CONNS=25
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_CONN_MAX_LIFETIME_SECONDS=1800

# Upper bound for a single migration run. The server logs progress every 10 seconds.
POSTGRES_MIGRATION_TIMEOUT_SECONDS=1800

# Non-compose deployments may set POSTGRES_DSN directly instead.
POSTGRES_DSN=

# Unsupported in this release. Do not set POSTGRES_READ_DSN; startup rejects
# replica read configuration.
# POSTGRES_READ_DSN=

# =============================================================================
# V2 Authority
# =============================================================================

# Fresh installs initialize PostgreSQL V2 directly. Existing installations must
# complete the v2.1 cutover before upgrading to v2.2 cleanup releases.

# =============================================================================
# Redis Configuration (optional for single-node, required for multi-instance)
# =============================================================================

# Redis server address. Leave blank for single-node in-memory mode.
# Set to 127.0.0.1:6379 when running the compose redis profile.
REDIS_ADDR=

# Host port used by the expert compose example when Redis is enabled.
REDIS_PORT=6379

# Redis authentication (optional)
REDIS_PASSWORD=

# Redis database number (default: 0)
REDIS_DB=0

# Enable when REDIS_ADDR points to a TLS Redis endpoint.
REDIS_TLS_ENABLED=false

# Set true for multi-instance deployments. Startup then requires REDIS_ADDR so
# workers coordinate through Redis instead of process-local state.
DISTRIBUTED_COORDINATION_REQUIRED=false

# =============================================================================
# Rate Limiting Configuration
# =============================================================================

# General API rate limit per minute (default: 100)
RATE_LIMIT_PER_MINUTE=100

# =============================================================================
# Server-Sent Events (SSE) Configuration
# =============================================================================

# Heartbeat interval in seconds (default: 30)
SSE_HEARTBEAT_SECONDS=30

# Maximum duration of an SSE stream in seconds (default: 300 = 5 minutes)
SSE_MAX_DURATION_SECONDS=300

# Maximum concurrent SSE streams per client (default: 10)
SSE_MAX_CONCURRENT_STREAMS=10

# =============================================================================
# Embedding Configuration
# =============================================================================

# AI provider base URL (required for server startup)
AI_API_URL=https://api.openai.com/v1

# AI provider API key (required for server startup)
AI_API_KEY=

# Embedding model name (required for server startup)
AI_API_EMBEDDING_MODEL=text-embedding-3-large

# Embedding dimensions must match the provider/model output (required for server startup)
AI_API_EMBEDDING_DIMENSIONS=3072

# Fully local alternative (Ollama running on the Docker host):
#   AI_API_URL=http://host.docker.internal:11434/v1
#   AI_API_KEY=ollama            # any non-empty value; Ollama ignores it
#   AI_API_EMBEDDING_MODEL=nomic-embed-text
#   AI_API_EMBEDDING_DIMENSIONS=768
# Also set AI_VERIFIER_MODEL below to a model that exists on your provider, and
# raise AI_VERIFIER_TIMEOUT_SECONDS if the model needs time to load.

# Embedding request timeout in seconds (default: 30)
AI_API_EMBEDDING_TIMEOUT_SECONDS=30

# Process-wide embedding provider request limit (default: 8)
AI_API_EMBEDDING_MAX_CONCURRENCY=8

# Concurrent embedding workers (default: 2; must not exceed the provider limit)
EMBEDDING_WORKER_COUNT=2

# Jobs claimed per embedding request (default: 64; range: 1-256)
EMBEDDING_BATCH_SIZE=64

# Delay before probing an idle team for embedding work again (default: 1 second)
EMBEDDING_JOB_POLL_SECONDS=1

# Maximum durable attempts for each derived embedding job (default: 20).
# Changing this affects newly queued jobs; upgrades repair legacy transient
# timeout failures that exhausted the old five-attempt default.
EMBEDDING_JOB_MAX_ATTEMPTS=20

# Verifier provider base URL for semantic placement evidence checks.
# Leave blank to reuse AI_API_URL.
AI_VERIFIER_API_URL=

# Verifier provider API key.
# Leave blank to reuse AI_API_KEY only when AI_VERIFIER_API_URL is also blank.
AI_VERIFIER_API_KEY=

# Chat/completions model used by the one-call placement assessor.
AI_VERIFIER_MODEL=gpt-4o-mini

# Set true to omit temperature from verifier requests for providers/models that reject it.
AI_VERIFIER_DISABLE_TEMPERATURE=false

# Verifier request timeout in seconds (default: 60)
AI_VERIFIER_TIMEOUT_SECONDS=60

# Maximum concurrent verifier requests (default: 5)
AI_VERIFIER_MAX_CONCURRENCY=5

# Server-accepted token limits for one complete assessor request. These values
# fit the gpt-4o-mini example model; choose limits compatible with any model
# you configure. The server does not send a provider max-token parameter.
AI_VERIFIER_MAX_INPUT_TOKENS=128000
AI_VERIFIER_MAX_OUTPUT_TOKENS=16384
AI_VERIFIER_MAX_CANDIDATE_CONTEXT_TOKENS=50000
AI_VERIFIER_TOKENIZER=o200k_base

# Global inclusive confidence threshold for positive entailed support (0..1).
# A manager can set a team-specific memory_write override.
MEMORY_AUTO_WRITE_CONFIDENCE_THRESHOLD=0.7

# Concurrent memory-placement workers (default: 1; must not exceed verifier concurrency).
# A high-throughput deployment may set both values to 30 after verifying provider
# capacity, PostgreSQL headroom, and request latency.
MEMORY_PLACEMENT_WORKER_COUNT=1

# Delay before probing an idle team for placement work again (default: 5 seconds)
MEMORY_PLACEMENT_POLL_SECONDS=5

# Dreaming uses the same AI verifier provider, API key, model, and timeout.
# Configure AI_VERIFIER_* above; there are no separate AI_DREAMING_* env vars.

# =============================================================================
# Knowledge Pipeline Configuration
# =============================================================================

# Placement commit transaction timeout in seconds (default: 10).
# The environment variable retains its deployed name for configuration compatibility.
PROMOTE_TX_TIMEOUT_SECONDS=10
# Import history window for memory-pack imports.
MEMORY_PACK_IMPORT_HISTORY_DAYS=30

# =============================================================================
# Demo Compose Configuration (examples/docker-compose.demo.yml)
# =============================================================================

# Public URL shown by the demo app when served behind a public ingress.
DEMO_PUBLIC_BASE_URL=

# Required versioned demo image. No rolling demo tag is published.
# Example: ghcr.io/markhuangai/dense-mem:demo-v2.4.1
DENSE_MEM_DEMO_IMAGE=

# Host bind and port for the demo compose example.
DENSE_MEM_DEMO_BIND=127.0.0.1
DENSE_MEM_DEMO_PORT=8080
