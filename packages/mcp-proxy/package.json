{
  "name": "dense-mem-mcp-proxy",
  "version": "0.1.0",
  "description": "Dense-Mem MCP stdio proxy for Streamable HTTP clients",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/markhuangai/dense-mem.git",
    "directory": "packages/mcp-proxy"
  },
  "keywords": [
    "dense-mem",
    "mcp",
    "stdio",
    "streamable-http"
  ],
  "type": "module",
  "bin": {
    "dense-mem-mcp-proxy": "bin/dense-mem-mcp-proxy.js"
  },
  "files": [
    "bin",
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "test:coverage": "c8 --all --src src --exclude 'tests/**' --exclude 'src/**/*.test.js' --exclude bin --reporter=text --reporter=json-summary npm test",
    "start": "node bin/dense-mem-mcp-proxy.js"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "supergateway": "4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "c8": "12.0.0"
  },
  "overrides": {
    "supergateway": {
      "@modelcontextprotocol/client": "2.3.1",
      "@modelcontextprotocol/server": "2.3.1",
      "@modelcontextprotocol/sdk": "$@modelcontextprotocol/sdk",
      "@modelcontextprotocol/node": "2.1.1"
    },
    "zod": "4.6.7"
  }
}
