{
  "schema_version": 2,
  "capability": "application-services",
  "source_ownership": [
    {
      "path": "cmd/internal/serverapp/operation_log_composition.go"
    },
    {
      "path": "cmd/internal/serverapp/usage_metrics_composition.go"
    },
    {
      "path": "cmd/internal/serverapp/telemetry_composition.go"
    },
    {
      "path": "cmd/internal/serverapp/telemetry.go"
    }
  ],
  "go": {
    "units": [
      {
        "id": "github.com/markhuangai/dense-mem/internal/operations",
        "role": "application_api",
        "visibility": "public"
      },
      {
        "id": "github.com/markhuangai/dense-mem/internal/operations/contract",
        "role": "port",
        "visibility": "public"
      },
      {
        "id": "github.com/markhuangai/dense-mem/internal/operations/postgres",
        "role": "postgres_adapter",
        "visibility": "private"
      }
    ]
  },
  "workers": [
    {
      "path": "internal/operations/operation_log_service.go",
      "function": "Start",
      "kind": "goroutine",
      "ordinal": 1,
      "role": "worker"
    },
    {
      "path": "internal/operations/telemetry_catalog.go",
      "function": "runTelemetryInstantQueries",
      "kind": "goroutine",
      "ordinal": 1,
      "role": "worker"
    },
    {
      "path": "internal/operations/telemetry_catalog.go",
      "function": "runTelemetryRangeQueries",
      "kind": "goroutine",
      "ordinal": 1,
      "role": "worker"
    },
    {
      "path": "internal/operations/usage_metrics_service.go",
      "function": "Start",
      "kind": "goroutine",
      "ordinal": 1,
      "role": "worker"
    }
  ]
}
