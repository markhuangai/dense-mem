{
  "name": "dense-mem-repo-lint",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:lines": "cd .. && .lint/node_modules/.bin/textlint --config .textlintrc.json --ignore-path .textlintignore --format stylish \"**/*.{css,go,html,js,json,md,sh,sql,toml,ts,tsx,txt,yaml,yml}\""
  },
  "devDependencies": {
    "glob": "14.0.6",
    "js-yaml": "5.5.0",
    "textlint": "^16.1.1",
    "textlint-rule-max-number-of-lines": "^1.0.3"
  },
  "overrides": {
    "js-yaml": "$js-yaml",
    "glob": "$glob"
  }
}
