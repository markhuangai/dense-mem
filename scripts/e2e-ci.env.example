# Copy this file to the dedicated CI user's dense-mem-ci/.env and set mode 0600.
# Use CI-only credentials. Never reuse staging or production credentials.
LOG_LEVEL=warn
CONTROL_PORTAL_TOKEN=
TELEMETRY_ENABLED=true
TELEMETRY_SCRAPE_TOKEN=
POSTGRES_USER=densemem
POSTGRES_PASSWORD=
POSTGRES_DB=densemem
POSTGRES_SSLMODE=disable
AI_API_URL=https://api.openai.com/v1
AI_API_KEY=
AI_API_EMBEDDING_MODEL=text-embedding-3-large
AI_API_EMBEDDING_DIMENSIONS=3072
AI_VERIFIER_API_URL=
AI_VERIFIER_API_KEY=
AI_VERIFIER_MODEL=gpt-4o-mini
DENSE_MEM_CI_TEST_IMAGE=mcr.microsoft.com/playwright:v1.62.1-noble
# Go image used by trusted controller prechecks and internal primitive drivers.
DENSE_MEM_CI_GO_TEST_IMAGE=golang:1.26.6-bookworm
# Set this to the daemon ID reported by `docker info` for the dedicated CI daemon.
DENSE_MEM_CI_DAEMON_ID=
