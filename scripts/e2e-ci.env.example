# Hosted CI generates this file under RUNNER_TEMP. For local E2E, copy it to an
# ignored mode-0600 path and use CI-only credentials.
LOG_LEVEL=info
CONTROL_PORTAL_TOKEN=
TELEMETRY_ENABLED=true
POSTGRES_USER=densemem
POSTGRES_PASSWORD=
POSTGRES_DB=densemem
POSTGRES_SSLMODE=disable
# Replace with the Docker socket path from the active context.
DOCKER_HOST=unix:///run/user/1001/docker.sock
AI_API_URL=https://api.cloudflare.com/client/v4/accounts/ACCOUNT_ID/ai/v1
AI_API_KEY=
AI_API_EMBEDDING_MODEL=@cf/baai/bge-m3
AI_API_EMBEDDING_DIMENSIONS=1024
AI_API_EMBEDDING_MAX_BATCH_ITEMS=100
AI_API_EMBEDDING_MAX_CONCURRENCY=2
AI_VERIFIER_API_URL=
AI_VERIFIER_API_KEY=
AI_VERIFIER_MODEL=gpt-4o-mini
AI_REMEMBER_MODEL=
AI_CONFLICT_REVIEW_MODEL=
# Go image used by trusted controller prechecks and internal primitive drivers.
DENSE_MEM_CI_GO_TEST_IMAGE=golang:1.26.9-bookworm
# Store the telemetry token separately in dense-mem-ci/telemetry-scrape-token.

# Optional decisions for live runs. The decision_providers scenario supplies its
# own HTTP fixtures and exercises both vendor adapters without live credentials.
AI_DECISION_PROVIDER=disabled
AI_DECISION_API_URL=
AI_DECISION_API_KEY=
AI_DECISION_MODEL=
AI_DECISION_MAX_INPUT_TOKENS=32000
AI_DECISION_MAX_QUESTION_INPUT_TOKENS=32000
AI_DECISION_TIMEOUT_SECONDS=10
AI_DECISION_MAX_CONCURRENCY=4
AI_DECISION_LONG_CONTEXT_ENABLED=false
